* text=auto

# Docker/Linux runtime files must stay LF even when cloned on Windows.
*.sh text eol=lf
*.md text eol=lf
*.toml text eol=lf
LICENSE text eol=lf
.devcontainer/Dockerfile text eol=lf
.devcontainer/.env.example text eol=lf

# Agent and container configuration is read inside Linux containers.
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

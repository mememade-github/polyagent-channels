# Copy to .devcontainer/.env, chmod 600, then edit.
# --- Instance identifiers (a second instance changes both, IMAGE_NAME and CHANNEL_PORT) ---
COMPOSE_PROJECT_NAME=polyagent-channels
CONTAINER_NAME=polyagent-channels
# --- Image selection (the build tags it; the rollback retags it) ---
IMAGE_NAME=polyagent-channels-polyagent-channels
IMAGE_TAG=latest
# --- Optional overrides ---
# HOST_WORKSPACE_PATH=<absolute project path on Docker daemon host>
# CHANNEL_BIND=0.0.0.0  # default: all IPv4 interfaces; 127.0.0.1 for single-PC use
# CHANNEL_PORT=<host port>  # default: 18765
# CHANNEL_RETENTION_DAYS=7  # 0 disables message expiration
# CHANNEL_MAX_STORAGE_BYTES=1073741824
# CHANNEL_LOG_MAX_SIZE=10m
# CHANNEL_LOG_MAX_FILES=3
# REDIS_AOF_REWRITE_PERCENTAGE=50
# REDIS_AOF_REWRITE_MIN_SIZE=64mb

# Optional overrides. Copy to .devcontainer/.env, chmod 600, then edit.
# HOST_WORKSPACE_PATH=<absolute project path on Docker daemon host>
# INSTANCE_NAME=<container name>
# CHANNEL_BIND=<127.0.0.1 or LAN bind address>
# CHANNEL_PORT=<host port>
# CHANNEL_RETENTION_DAYS=30  # 0 disables message expiration

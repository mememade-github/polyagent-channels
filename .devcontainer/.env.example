# Settings and procedures: ../REFERENCE.md#configuration-devcontainerenv
# Defaults: docker-compose.yml. Uncomment only overrides for this instance.
# COMPOSE_PROJECT_NAME=<project-name>
# CONTAINER_NAME=<service-container-name>
# IMAGE_NAME=<service-image-name>
# IMAGE_TAG=<service-image-tag>
# HOST_WORKSPACE_PATH=<absolute-project-path-on-Docker-daemon-host>
# CHANNEL_BIND=<host-bind-address>
# CHANNEL_PORT=<host-port>
# CHANNEL_RETENTION_DAYS=<days>
# CHANNEL_MAX_STORAGE_BYTES=<bytes>
# CHANNEL_LOG_MAX_SIZE=<segment-size>
# CHANNEL_LOG_MAX_FILES=<segment-count>
# REDIS_AOF_REWRITE_PERCENTAGE=<growth-percentage>
# REDIS_AOF_REWRITE_MIN_SIZE=<size>

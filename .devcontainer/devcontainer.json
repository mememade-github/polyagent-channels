{
  "name": "Polyagent Channels",
  "dockerComposeFile": "compose.channels.yml",
  "service": "polyagent-channels",
  "workspaceFolder": "/workspaces",
  "remoteUser": "vscode",
  "overrideCommand": false,
  "initializeCommand": ["docker", "compose", "--env-file", ".devcontainer/.env", "-f", ".devcontainer/compose.channels.yml", "build", "devcontainer-base"],
  "shutdownAction": "stopCompose"
}
